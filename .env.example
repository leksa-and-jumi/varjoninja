# Copy to .env.local and fill in. Never commit .env.local.
# Room server (Cloudflare Worker). The real one lets local and online players meet;
# use http://localhost:8791 with `npm run dev:room` when changing the protocol.
VITE_ROOM_URL=https://varjoninja-huoneet.mrjv.workers.dev
# For npm run room:deploy
CLOUDFLARE_API_TOKEN=TAYTA_TAHAN
CLOUDFLARE_ACCOUNT_ID=TAYTA_TAHAN
# Only for scripts that generate music once (not used by the game itself)
OPENROUTER_API_KEY=TAYTA_TAHAN
