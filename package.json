{
  "name": "varjoninja",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ninja hero game in a big 3D city / Varjoninja seikkailee kaupungissa",
  "scripts": {
    "dev": "vite",
    "dev:room": "wrangler dev --port 8791",
    "room:deploy": "node scripts/wrangler.mjs deploy",
    "models": "/Applications/Blender.app/Contents/MacOS/Blender --background --factory-startup --python blender/build_models.py",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
